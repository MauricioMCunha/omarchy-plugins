#!/usr/bin/env bash
set -euo pipefail

# Transparent sudo compatibility layer. It makes ordinary `sudo command`
# invoke the local askpass flow without requiring the caller to remember -A.
# Explicit non-interactive/stdin modes remain untouched.

readonly real_sudo="/usr/bin/sudo"
readonly runtime_dir="${XDG_RUNTIME_DIR:?}/omarchy-secure-input"
readonly plugin_dir="${SECURE_INPUT_PLUGIN_DIR:-${HOME}/.config/omarchy/plugins/mauricio.secure-input}"
readonly askpass="${SECURE_INPUT_ASKPASS:-${plugin_dir}/askpass.py}"

for arg in "$@"; do
  case "$arg" in
    -A|--askpass|-S|--stdin|-n|--non-interactive|-*[ASn]*)
      exec "$real_sudo" "$@"
      ;;
  esac
done

case "${1:-}" in
  -h|--help|-V|--version)
    exec "$real_sudo" "$@"
    ;;
esac

[[ -x "$askpass" || -f "$askpass" ]] || {
  echo "secure-input: askpass não está instalado em $askpass" >&2
  exit 1
}

export SUDO_ASKPASS="$askpass"
export SECURE_INPUT_SOCKET="${SECURE_INPUT_SOCKET:-${runtime_dir}/broker.sock}"
export SECURE_INPUT_COMMAND="sudo $*"
export PYTHONPATH="${plugin_dir}${PYTHONPATH:+:${PYTHONPATH}}"

exec "$real_sudo" -A "$@"
