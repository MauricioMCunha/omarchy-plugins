#!/usr/bin/env bash
set -euo pipefail

# Run one command in an isolated secure-input execution profile. The temporary
# PATH shadows `sudo` only for this child process and is removed on exit.

(( $# > 0 )) || {
  echo "uso: secure-input-run -- comando [argumentos...]" >&2
  exit 64
}
if [[ "$1" == "--" ]]; then
  shift
fi
(( $# > 0 )) || {
  echo "uso: secure-input-run -- comando [argumentos...]" >&2
  exit 64
}

readonly script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly bin_dir="$(mktemp -d "${TMPDIR:-/tmp}/secure-input-bin.XXXXXX")"
cleanup() { rm -rf -- "$bin_dir"; }
trap cleanup EXIT INT TERM

ln -s -- "$script_dir/secure-input-sudo" "$bin_dir/sudo"
export PATH="$bin_dir:$PATH"
exec "$@"
