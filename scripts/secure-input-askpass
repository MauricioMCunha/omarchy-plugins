#!/usr/bin/env bash
set -euo pipefail

# SUDO_ASKPASS entrypoint. It reads session material from the private runtime
# directory and never places the secret in argv, files or shell output.
runtime_dir="${XDG_RUNTIME_DIR:?}/omarchy-secure-input"
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

readonly socket_path="${SECURE_INPUT_SOCKET:-${runtime_dir}/broker.sock}"
readonly token_file="${SECURE_INPUT_TOKEN_FILE:-${runtime_dir}/token}"
readonly capability_file="${SECURE_INPUT_CAPABILITY_FILE:-${runtime_dir}/llm-capability}"

[[ -S "$socket_path" && -r "$token_file" && -r "$capability_file" ]] || exit 1
umask 077
export SECURE_INPUT_SOCKET="$socket_path"
export SECURE_INPUT_TOKEN="$(<"$token_file")"
export SECURE_INPUT_LLM_CAPABILITY="$(<"$capability_file")"
export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${project_dir}"

exec /usr/bin/python3 -m services.secure_input_broker.askpass "$@"
